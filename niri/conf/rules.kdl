
// ██████╗░██╗░░░██╗██╗░░░░░███████╗░██████╗
// ██╔══██╗██║░░░██║██║░░░░░██╔════╝██╔════╝
// ██████╔╝██║░░░██║██║░░░░░█████╗░░╚█████╗░
// ██╔══██╗██║░░░██║██║░░░░░██╔══╝░░░╚═══██╗
// ██║░░██║╚██████╔╝███████╗███████╗██████╔╝
// ╚═╝░░╚═╝░╚═════╝░╚══════╝╚══════╝╚═════╝░


// Wallpaper (swaybg / DMS)
layer-rule {
    match namespace="^wallpaper$"
    match namespace="^quickshell$"
    place-within-backdrop true
}

// Corner radius for all windows
window-rule {
    geometry-corner-radius 18
    clip-to-geometry true
}

// Background blur for all windows
window-rule {
    background-effect {
        blur true
        xray false
    }
}

// Blocked apps from screencasting
window-rule {
    // Bank pages; while one loads its title can be just the address (centrum24.pl)
    match app-id=r#"(?i)zen"# title=r#"(?i)(santander|erste|centrum24)"#
    match app-id=r#"(?i)firefox"# title=r#"(?i)(santander|erste|centrum24)"#
    match app-id=r#"(?i)chrome"# title=r#"(?i)(santander|erste|centrum24)"#
    match app-id=r#"(?i)obsidian"# title=r#"(?i)быт"#
    match app-id=r#"(?i)^clipse$"#
    block-out-from "screencast"
}

// Picture in picture mode
window-rule {
    match app-id=r#"(?i)firefox"# title=r#"(?i)picture-in-picture"#
    match app-id=r#"(?i)chrome"# title=r#"(?i)picture-in-picture"#
    match app-id=r#"(?i)firefox"# title=r#"(?i)картинка в картинке"#
    match app-id=r#"(?i)chrome"# title=r#"(?i)картинка в картинке"#
    match app-id=r#"(?i)zen"# title=r#"(?i)picture-in-picture"#
    match app-id=r#"(?i)zen"# title=r#"(?i)картинка в картинке"#
    open-floating true
}

// Clipse
window-rule {
    match app-id=r#"(?i)^clipse$"#
    open-floating true
    default-column-width { fixed 622; }
    default-window-height { fixed 652; }
}

// kitty, Alacritty (terminal)
window-rule {
    match app-id=r#"(?i)kitty"#
    match app-id=r#"(?i)alacritty"#
    default-column-width { proportion 0.5; }
}

// Obsidian
window-rule {
    match app-id=r#"(?i)obsidian"#
    scroll-factor 0.2
}

// Rofi
layer-rule {
    match namespace="^rofi$"
    background-effect {
        blur true
        xray false
        saturation 1.5
        noise 0.05
    }
}

// Apps that should open on the "_media" workspace
window-rule {
    match app-id=r#"(?i)telegram"#
    match app-id=r#"(?i)org\.ime\.desktop"#
    match app-id=r#"(?i)spotify"#
    match app-id=r#"(?i)vesktop"#
    match app-id=r#"(?i)discord"#
    exclude app-id=r#"(?i)telegram"# title=r#"(?i)просмотр медиа"#
    
    open-on-workspace "_media"
}

// Apps that should open on the "browser" workspace
window-rule {
  match app-id=r#"(?i)zen"#
  match app-id=r#"(?i)chrome"#
  match app-id=r#"(?i)firefox"#

  open-on-workspace "browser"
}

// Apps that should open on the "ide" workspace
window-rule {
    match app-id=r#"(?i)code"#
    match app-id=r#"(?i)jetbrains-idea"#
    match app-id=r#"(?i)antigravity"#

    open-on-workspace "ide"
}

// Apps that should open on the "notes" workspace
window-rule {
    match app-id=r#"(?i)obsidian"#
    
    open-on-workspace "notes"
}

// Indicate screencasted windows with red colors
window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#f38ba8"
        inactive-color "#7d0d2d"
    }

    border {
        inactive-color "#7d0d2d"
    }

    shadow {
        color "#7d0d2d70"
    }

    tab-indicator {
        active-color "#f38ba8"
        inactive-color "#7d0d2d"
    }
}