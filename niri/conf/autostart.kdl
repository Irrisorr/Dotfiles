// Required for clipboard history integration
spawn-at-startup "bash" "-c" "wl-paste --watch cliphist store &"

// Elevation prompts. The agent binary lives at a different path on every
// distro, so the wrapper resolves it instead of hardcoding one here.
spawn-sh-at-startup "~/Dotfiles/scripts/wrappers/polkit-agent.sh mate"

// Starts DankShell
spawn-at-startup "dms" "run"

// Wallpaper swaybg
spawn-sh-at-startup "swaybg -i /home/irrisorr/Dotfiles/wallpaper/night-sky.png -m fill"

// Apps 
// spawn-at-startup "waybar"
spawn-at-startup "syncthing"
spawn-sh-at-startup "clipse -listen"
spawn-sh-at-startup "killall xdg-desktop-portal xdg-desktop-portal-gtk xdg-desktop-portal-gnome xdg-desktop-portal-kde"
