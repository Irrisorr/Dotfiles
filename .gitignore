# Sine engine (installed by updater.sh) and Zen-generated mod styles
zen-browser/chrome/JS/
zen-browser/chrome/utils/
zen-browser/chrome/zen-themes.css
# Sine mod files only used by their README / the store page
zen-browser/chrome/sine-mods/*/.asset/
zen-browser/chrome/sine-mods/*/README.md
zen-browser/chrome/sine-mods/*/*.png
zen-browser/chrome/sine-mods/*/*.jpg

# DMS run-state markers (first launch, seen changelogs)
dms/.firstlaunch
dms/.changelog-*
# DMS plugin clones — restored from dms/plugins.lock.json
dms/plugins/
# Wallpaper colors DMS writes with matugen (change with every wallpaper)
niri/dms/colors.kdl
kitty/dank-*.conf
dms/zen.css
dms/firefox.css
